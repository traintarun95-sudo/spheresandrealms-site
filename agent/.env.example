# Know Your Brand — Brand Agent environment variables
# Copy this file to .env and fill in your keys
# Never commit .env to git

# Twitter/X API v2 Bearer Token
# Get from: https://developer.twitter.com/en/portal/dashboard
TWITTER_BEARER_TOKEN=

# SerpAPI key (used to search Quora via Google)
# Get from: https://serpapi.com/
SERP_API_KEY=

# AI provider — at least one required for AI-generated drafts
# If neither is set, the agent uses a fallback template instead

# Anthropic Claude (preferred)
ANTHROPIC_API_KEY=

# OpenAI (fallback)
OPENAI_API_KEY=
