# Know Your Brand — Brand Agent environment variables
# Copy this file to .env and fill in your keys
# Never commit .env to git

# Anthropic API key — used for brand extraction and draft generation
# Uses Claude Haiku throughout — cheapest capable model
ANTHROPIC_API_KEY=

# Tavily API key — used to search brand news from curated sources
# Free tier: 1,000 searches/month
# Get from: https://tavily.com/
TAVILY_API_KEY=

# Telegram — agent sends thread URLs and drafts here
# Bot token: message @BotFather on Telegram → /newbot
# Chat ID: message @userinfobot on Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# KYB API URL — the Know Your Brand backend
# Default is the Railway production URL — only change if running locally
KYB_API_URL=https://know-your-brand-production.up.railway.app
